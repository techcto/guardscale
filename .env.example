GUARDSCALE_ROOT_USER=root
GUARDSCALE_ROOT_PASSWORD=replace-with-a-long-root-password
GUARDSCALE_SESSION_SECRET=replace-with-at-least-32-random-characters
GUARDSCALE_DEPLOYMENT_MODE=on-premise
GUARDSCALE_WHATSAPP_ORIGINATION_ID=
# Launch parameter: set a registered WABA ID and leave the topic ARN blank to create managed SNS routing.
GUARDSCALE_WHATSAPP_BUSINESS_ACCOUNT_ID=
GUARDSCALE_NOTIFICATION_RECIPIENTS=
GUARDSCALE_SES_FROM=
# Optional comma-separated signup domain blocklist, e.g. gmail.com; empty permits all valid domains.
GUARDSCALE_BLOCKED_SIGNUP_DOMAINS=
# Real inference/delivery are opt-in. SNS must be the trusted EUM Social event topic.
GUARDSCALE_AI_MODEL_ID=
# Optional local --bedrock override: absolute host path, never the credentials themselves.
GUARDSCALE_BEDROCK_CREDENTIALS_PATH=
AWS_REGION=us-east-1
GUARDSCALE_NOTIFICATION_MODE=log
GUARDSCALE_PUBLIC_URL=
GUARDSCALE_WHATSAPP_SNS_TOPIC_ARN=
# Local real-delivery testing uses the resulting WhatsappEventTopicArn stack output above.
# Approved WhatsApp template with one body text variable, for alerts outside a conversation.
GUARDSCALE_WHATSAPP_ALERT_TEMPLATE=
GUARDSCALE_WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Local Docker always runs Stripe in sandbox mode and refuses live keys; deployed stacks set StripeMode.
GUARDSCALE_STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
# Usage-based overage (saas only, off by default). Prices come from devops/stripe/setup-plans.mjs.
GUARDSCALE_USAGE_EXPORT=disabled
STRIPE_SERVER_OVERAGE_PRICE_ID=
STRIPE_LOG_OVERAGE_PRICE_ID=
STRIPE_AI_OVERAGE_PRICE_ID=
# Log MB included per plan, e.g. {"dev":<mb>,"starter":<mb>,"scale":<mb>}. Empty leaves logs unmetered.
GUARDSCALE_LOG_MB_INCLUDED_JSON=
# {"version":"v1","included_credits":{"<plan>":<credits>},"models":{"<model-id>":{"input_per_1k":<n>,"output_per_1k":<n>}}}. Empty leaves AI unpriced.
GUARDSCALE_AI_CREDIT_WEIGHTS_JSON=
GUARDSCALE_USAGE_CYCLE_SECONDS=300
GUARDSCALE_TABLE=guardscale-local
GUARDSCALE_QUEUE_URL=http://queue.invalid/local
GUARDSCALE_EVIDENCE_BUCKET=guardscale-local-evidence
# Buyer-facing Marketplace listing URL (https://aws.amazon.com/marketplace/pp/prodview-...)
GUARDSCALE_MARKETPLACE_URL=
