[Unit]
Description=GuardScale infrastructure agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/guardscale/enrollment.token

[Service]
Type=simple
ExecStart=/usr/local/bin/guardscale run --config /etc/guardscale/config.yaml
Restart=on-failure
RestartSec=5s
StateDirectory=guardscale
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guardscale
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
